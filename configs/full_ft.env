# Configuration for the paper's full fine-tuning runs (Qwen3-VL-8B-Thinking, two H200 GPUs).
# Every value can be overridden from the environment. Keep these identical across arms.
export MODEL_PATH=${MODEL_PATH:-Qwen/Qwen3-VL-8B-Thinking}
export SEED=${SEED:-42}
export GPUS=${GPUS:-0,1}
export TP_SIZE=${TP_SIZE:-2}
export FAITH_FORCE_CVD=${FAITH_FORCE_CVD:-1}          # GPU that hosts the probe's feature extractor

# Training length and batching: batch 16 gives about one epoch in 250 steps.
export TOTAL_STEPS=${TOTAL_STEPS:-250}
export TRAIN_BATCH_SIZE=${TRAIN_BATCH_SIZE:-16}
export PPO_MINI_BATCH=${PPO_MINI_BATCH:-16}
export ROLLOUT_N=${ROLLOUT_N:-8}
export SAVE_FREQ=${SAVE_FREQ:-15}
export TEST_FREQ=${TEST_FREQ:-15}
export SAVE_CONTENTS=${SAVE_CONTENTS:-[model,extra]}

# Optimization.
export LR=${LR:-1e-6}
export LR_WARMUP_RATIO=${LR_WARMUP_RATIO:-0.05}
export KL_COEF=${KL_COEF:-0.04}
export ENTROPY_COEF=${ENTROPY_COEF:-0.001}
export GRAD_CKPT=${GRAD_CKPT:-True}
export PARAM_OFFLOAD=${PARAM_OFFLOAD:-False}
export OPTIMIZER_OFFLOAD=${OPTIMIZER_OFFLOAD:-False}
export MAX_TOKEN_LEN_PER_GPU=${MAX_TOKEN_LEN_PER_GPU:-8192}

# Rollout. The 4096-token response budget also applies to probe collection and evaluation.
export MAX_RESPONSE=${MAX_RESPONSE:-4096}
export MAX_MODEL_LEN=${MAX_MODEL_LEN:-8192}
export GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.45}
export ENFORCE_EAGER=${ENFORCE_EAGER:-True}
export MAX_NUM_SEQS=${MAX_NUM_SEQS:-128}
export CHUNKED_PREFILL=${CHUNKED_PREFILL:-True}

# Scoring and safety checks.
export STRICT_CORRECTNESS=${STRICT_CORRECTNESS:-1}    # no closed <answer> tag scores 0
export FAITH_STRICT=${FAITH_STRICT:-1}                # a missing probe signal is fatal
export BATCH_ID_LOG=${BATCH_ID_LOG:-1}                # log batch ids to verify matched data order
